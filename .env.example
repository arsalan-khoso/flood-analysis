# Required: free Mapbox public token (pk.*) from https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=

# AI (optional). Free option for testing: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b   # optional override; see manage.py groq_models

# Paid alternative, used only if GROQ_API_KEY is empty
ANTHROPIC_API_KEY=

# Optional: Postgres instead of local SQLite, e.g. a free Neon database
# DATABASE_URL=postgres://user:pass@host/db

DEBUG=1
# SECRET_KEY=change-me-in-production
